# ============================================================
# 某行知识库 Demo 后端配置
# 复制为 .env 后按需填写；不填任何 LLM 配置也能跑（Mock 模式）
# ============================================================

# ---- LLM（OpenAI 兼容接口：GLM / DeepSeek / Qwen / vLLM 均可）----
# 智谱 GLM 示例：
# KB_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# KB_LLM_API_KEY=你的APIKey
# KB_LLM_MODEL=glm-4.6
# KB_EMB_MODEL=embedding-3
# DeepSeek 示例（也可通过环境变量 DEEPSEEK_API_KEY 提供密钥）：
# KB_LLM_BASE_URL=https://api.deepseek.com
# KB_LLM_API_KEY=你的APIKey
# KB_LLM_MODEL=deepseek-flash
# 不配置 KB_EMB_BASE_URL 时使用关键词检索，无需单独购买向量服务。
KB_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
KB_LLM_API_KEY=
KB_LLM_MODEL=glm-4.6
KB_LLM_MAX_TOKENS=4096
# DeepSeek 默认关闭思考以降低延迟；需要时改为 enabled。
KB_LLM_THINKING=disabled
KB_EMB_BASE_URL=
KB_EMB_API_KEY=
KB_EMB_MODEL=embedding-3
# 本地真实语义检索（先安装 requirements-retrieval.txt 并下载模型）：
# KB_EMB_LOCAL_PATH=D:/project/backend/.local/models/Qwen3-Embedding-0.6B
# KB_RERANK_LOCAL_PATH=D:/project/backend/.local/models/Qwen3-Reranker-0.6B
# 本地模型只读取已下载权重，请勿填写远程模型名替代本地路径。
KB_MODEL_DEVICE=cpu
KB_MODEL_CPU_THREADS=4
KB_RETRIEVAL_BATCH_SIZE=8
KB_CHILD_TOKENS=384
KB_RERANK_MIN_SCORE=0.01
# 普通问答走固定检索+一次生成，复杂比较/影响/调用链自动使用 Agent。
# flow / agent 可固定自动入口的策略；显式请求 mode 优先。
KB_QA_STRATEGY=auto
# Demo 默认关闭模型重排，即便填写了重排模型路径也不会加载或推理。
# 后续需要对比排序质量时改为 true；BM25+向量融合不受此开关影响。
KB_RERANK_ENABLED=false
# 以下是重新启用模型重排后的预算参数。
KB_RERANK_CANDIDATES=12
KB_RERANK_MAX_TOKENS=1024
KB_RERANK_BATCH_SIZE=4
# 仅缓存模型相关性分数；0 禁用，不复用未审核答案。
KB_RERANK_CACHE_SIZE=2048
# TEI rerank 端点（可选）
KB_RERANK_URL=

# ---- 长时记忆阈值（设计初值，可调）----
THRESHOLD_EXACT=0.95
THRESHOLD_SIMILAR=0.80

# ---- 存储连接（留空 = 内嵌回退：SQLite/文件图库/内嵌向量/本地对象目录）----
# 使用 docker-compose.yml 启动全套组件后填：
# KB_PG_DSN=postgresql+psycopg://kb:kb@localhost:5432/kb
# KB_GRAPH_URL=bolt://localhost:7687
# KB_GRAPH_PASSWORD=kbpass
# KB_VECTOR_URI=http://localhost:19530
# KB_S3_ENDPOINT=localhost:9000
# KB_S3_ACCESS_KEY=kbminioadmin
# KB_S3_SECRET_KEY=kbminioadmin
KB_PG_DSN=
KB_GRAPH_URL=

# ---- 数据集清洗（留空 = 自动使用仓库根目录下 hf_data）----
# KB_DATASET_ROOT=D:/zcode/hsbc/kb-system/hf_data
# 默认不自动导入素材；需要时手动上传或显式执行数据集接入。
KB_AUTO_IMPORT=false

# ---- 服务 ----
JWT_SECRET=hf-kb-demo-secret-change-me
