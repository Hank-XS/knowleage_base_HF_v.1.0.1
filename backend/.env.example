# ============================================================
# 某行知识库 Demo 后端配置
# 复制为 .env 后按需填写；不填任何 LLM 配置也能跑（Mock 模式）
# ============================================================

# ---- LLM（OpenAI 兼容接口：GLM / DeepSeek / Qwen / vLLM 均可）----
# 智谱 GLM 示例：
# KB_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# KB_LLM_API_KEY=你的APIKey
# KB_LLM_MODEL=glm-4.6
# KB_EMB_MODEL=embedding-3
KB_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
KB_LLM_API_KEY=
KB_LLM_MODEL=glm-4.6
KB_EMB_BASE_URL=
KB_EMB_API_KEY=
KB_EMB_MODEL=embedding-3
# TEI rerank 端点（可选）
KB_RERANK_URL=

# ---- 长时记忆阈值（设计初值，可调）----
THRESHOLD_EXACT=0.95
THRESHOLD_SIMILAR=0.80

# ---- 存储连接（留空 = 内嵌回退：SQLite/文件图库/内嵌向量/本地对象目录）----
# 使用 docker-compose.yml 启动全套组件后填：
# KB_PG_DSN=postgresql+psycopg://kb:kb@localhost:5432/kb
# KB_GRAPH_URL=bolt://localhost:7687
# KB_GRAPH_PASSWORD=kbpass
# KB_VECTOR_URI=http://localhost:19530
# KB_S3_ENDPOINT=localhost:9000
# KB_S3_ACCESS_KEY=kbminioadmin
# KB_S3_SECRET_KEY=kbminioadmin
KB_PG_DSN=
KB_GRAPH_URL=

# ---- 数据集清洗（留空 = 自动使用仓库根目录下 hf_data）----
# KB_DATASET_ROOT=D:/zcode/hsbc/kb-system/hf_data

# ---- 服务 ----
JWT_SECRET=hf-kb-demo-secret-change-me
