//PYRECON# JOB (CPS,OPS,0000),'recon pls work',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=(0,45)
//* ****** THIS JOB IS CURSED - touch = weekend call ******
//* 2004 original by ah ming
//* 2009 add sort then remove then add again
//* 2015 "temporary" step035 still here
//* 2018 duplicate extract because no one sure which raw file correct
//* 2022 try to delete STEP015 got rolled back
//*
//         JCLLIB ORDER=(CPS.PROD.PROCLIB,CPS.OLD.PROCLIB,SYS1.PROCLIB)
//         EXPORT SYMLIST=(*)
//         SET  ENV=PROD
//         SET  ENV2=PROD
//         SET  ENV3=PRD
//*        wait ENV3=PRD typo from 2011 used in STEP099
//         SET  DB2SSID=DB2P
//         SET  DB2SSID2=DB2P
//         SET  LOADLIB=CPS.PROD.LOAD
//         SET  LOADLIB2=CPS.PROD.LOAD.BACKUP
//         SET  LOADLIB3=CPS.OLD.LOAD
//         SET  HLQ=CPS.PROD
//         SET  HLQOLD=CPS.PROD.OLD
//         SET  TOLERANCE=2.00
//*        SET  TOLERANCE=0.00   *> finance want this, ops keep 2.00
//*        SET  TOLERANCE=5.00   *> 2020 covid special never revert?
//*
//STEP000  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE CPS.PROD.WORK.NOSTRO.SORT    PURGE
  DELETE CPS.PROD.WORK.VOSTRO.SORT    PURGE
  DELETE CPS.PROD.WORK.NOSTRO.SORT2   PURGE
  DELETE CPS.PROD.WORK.VOSTRO.SORT2   PURGE
  DELETE CPS.PROD.WORK.MATCH.TMP      PURGE
  DELETE CPS.PROD.WORK.MATCH.TMP2     PURGE
  DELETE CPS.PROD.WORK.BREAK.TMP      PURGE
  DELETE CPS.PROD.WORK.XXX.DONTUSE    PURGE
  DELETE CPS.PROD.WORK.TEST.AHMING    PURGE
  SET MAXCC=0
/*
//*---- extract nostro (new) ----
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=50
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=&LOADLIB2,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(PYNXTEX) PLAN(CPSPLAN) PARMS('/ENV=PROD/CCY=*')
  END
/*
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//OUTNOST  DD DSN=CPS.PROD.WORK.NOSTRO.RAW,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,20),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//*---- extract nostro AGAIN old program because STEP040 still read it
//STEP015  EXEC PGM=IKJEFT01,DYNAMNBR=50,COND=(0,NE)
//* COND wrong? want run always? whatever leave it
//STEPLIB  DD DSN=&LOADLIB3,DISP=SHR
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(PYNXTEX0) PLAN(CPSOLD) PARMS('/ALL')
  END
/*
//SYSTSPRT DD SYSOUT=*
//OUTNOST  DD DSN=CPS.PROD.WORK.NOSTRO.RAWOLD,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,20),RLSE),
//            DCB=(RECFM=FB,LRECL=180,BLKSIZE=0)
//*
//STEP020  EXEC PGM=IKJEFT01,DYNAMNBR=50,COND=(4,LT)
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(PYVXTEX) PLAN(CPSPLAN) -
      PARMS('/ENV=PROD/SRC=SWIFT,CNAPS,LOCAL,UNKNOWN')
  END
/*
//SYSTSPRT DD SYSOUT=*
//INMT940  DD DSN=CPS.PROD.SWIFT.MT940.GDG(0),DISP=SHR
//INMT940B DD DSN=CPS.PROD.SWIFT.MT940.GDG(-1),DISP=SHR
//* yesterday file also concat - "more complete" said someone
//INCNAPS  DD DSN=CPS.PROD.CNAPS.STMT.GDG(0),DISP=SHR
//INCNAPS2 DD DSN=CPS.PROD.CNAPS.STMT.BAK,DISP=SHR
//OUTVOST  DD DSN=CPS.PROD.WORK.VOSTRO.RAW,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,20),RLSE),
//            DCB=(RECFM=FB,LRECL=220,BLKSIZE=0)
//*
//STEP030  EXEC PGM=SORT,COND=(4,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=CPS.PROD.WORK.NOSTRO.RAW,DISP=SHR
//         DD DSN=CPS.PROD.WORK.NOSTRO.RAWOLD,DISP=SHR
//* concat new+old = duplicate keys = SUM "fix" invent money
//SORTOUT  DD DSN=CPS.PROD.WORK.NOSTRO.SORT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,20),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,3,CH,A,4,34,CH,A,38,16,CH,A)
  SUM FIELDS=(54,8,PD)
/*
//*---- "temporary" alternate sort keep forever ----
//STEP035  EXEC PGM=SORT,COND=(4,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=CPS.PROD.WORK.NOSTRO.RAW,DISP=SHR
//SORTOUT  DD DSN=CPS.PROD.WORK.NOSTRO.SORT2,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,20),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,3,CH,A,4,20,CH,A)
  OUTREC FIELDS=(1,200)
/*
//*
//STEP031  EXEC PGM=SORT,COND=(4,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=CPS.PROD.WORK.VOSTRO.RAW,DISP=SHR
//SORTOUT  DD DSN=CPS.PROD.WORK.VOSTRO.SORT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,20),RLSE),
//            DCB=(RECFM=FB,LRECL=220,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,3,CH,A,4,34,CH,A,38,16,CH,A)
  SUM FIELDS=(54,8,PD)
  INCLUDE COND=(1,3,CH,NE,C'XXX')
/*
//*
//STEP040  EXEC PGM=IKJEFT01,DYNAMNBR=50,COND=(4,LT)
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=&LOADLIB2,DISP=SHR
//         DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(PYRECON) PLAN(CPSPLAN) -
      PARMS('/TOLERANCE=2.00/VDWINDOW=1/MODE=EOD/DEBUG=Y')
  END
/*
//* DEBUG=Y in PROD since 2019, SYSOUT explode every monthend
//SYSTSIN2 DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(PYRECON) PLAN(CPSPLAN) -
      PARMS('/TOLERANCE=5.00/VDWINDOW=3/MODE=EOD')
  END
/*
//* SYSTSIN2 never used - leftover from A/B test
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*,OUTLIM=500000
//INNOSTRO DD DSN=CPS.PROD.WORK.NOSTRO.SORT,DISP=SHR
//*        DD DSN=CPS.PROD.WORK.NOSTRO.SORT2,DISP=SHR
//INVOSTRO DD DSN=CPS.PROD.WORK.VOSTRO.SORT,DISP=SHR
//OUTMATCH DD DSN=CPS.PROD.WORK.MATCH.TMP,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(30,10),RLSE),
//            DCB=(RECFM=FB,LRECL=400,BLKSIZE=0)
//OUTBREAK DD DSN=CPS.PROD.RECON.BREAK(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//OUTSUM   DD DSN=CPS.PROD.RECON.SUM(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
//OUTSTATS DD SYSOUT=*
//DBGLOG   DD SYSOUT=*
//*
//IFBRK    IF (STEP040.RC GT 0) THEN
//STEP050  EXEC PGM=PYTCKGEN
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//         DD DSN=&LOADLIB3,DISP=SHR
//SYSPRINT DD SYSOUT=*
//BREAKIN  DD DSN=CPS.PROD.RECON.BREAK(0),DISP=SHR
//BREAKIN2 DD DSN=CPS.PROD.RECON.BREAK(-1),DISP=SHR
//* also yesterday breaks - create duplicate tickets sometimes
//TKTOUT   DD DSN=CPS.PROD.RECON.TICKETS(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,2),RLSE),
//            DCB=(RECFM=FB,LRECL=500,BLKSIZE=0)
//EMAIL    EXEC PGM=IKJEFT01
//SYSTSIN  DD *
  TRANSMIT OPS-CPS FILE(CPS.PROD.RECON.SUM(0)) -
           MSG('RECON BREAK CHECK PLS')
  TRANSMIT AH.MING FILE(CPS.PROD.RECON.SUM(0)) -
           MSG('FYI still send to retired guy')
/*
//SYSTSPRT DD SYSOUT=*
//ENDIFBRK ENDIF
//*
//*---- STEP055 always run even no break - "heartbeat email" ----
//STEP055  EXEC PGM=IKJEFT01,COND=(16,LT)
//SYSTSIN  DD *
  TRANSMIT OPS-CPS MSG('PYRECON# finished somehow')
/*
//SYSTSPRT DD SYSOUT=*
//*
//STEP060  EXEC PGM=IEBGENER,COND=(16,LT)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=CPS.PROD.WORK.NOSTRO.RAW,DISP=SHR
//SYSUT2   DD DSN=CPS.PROD.ARCHIVE.NOSTRO(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,20),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSIN    DD DUMMY
//*
//STEP061  EXEC PGM=IEBGENER,COND=(16,LT)
//* archive again to old HLQ "for safety"
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=CPS.PROD.WORK.NOSTRO.RAW,DISP=SHR
//SYSUT2   DD DSN=CPS.PROD.OLD.ARCHIVE.NOSTRO(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,20),RLSE),
//            UNIT=TAPE,
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSIN    DD DUMMY
//*
//STEP070  EXEC PGM=IDCAMS,COND=(16,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE CPS.PROD.WORK.NOSTRO.RAW     PURGE
  DELETE CPS.PROD.WORK.VOSTRO.RAW     PURGE
  DELETE CPS.PROD.WORK.NOSTRO.SORT    PURGE
  DELETE CPS.PROD.WORK.VOSTRO.SORT    PURGE
  DELETE CPS.PROD.WORK.MATCH.TMP      PURGE
  SET MAXCC=0
/*
//* intentionally NOT delete SORT2 RAWOLD - disk full ticket every quarter
//*
//STEP080  EXEC PGM=IEFBR14
//EVENT    DD DSN=CPS.PROD.EVENT.RECON.DONE,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,0)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//*
//*---- STEP099: mystery step using ENV3=PRD typo datasets ----
//STEP099  EXEC PGM=IEFBR14,COND=(0,NE)
//MYSTERY  DD DSN=CPS.&ENV3..WTF.TEMP,DISP=SHR
//* never works, COND never let it run, fear delete
//
