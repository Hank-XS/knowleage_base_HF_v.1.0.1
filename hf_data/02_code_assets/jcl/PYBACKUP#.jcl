//PYBACKUP# JOB (CPS,OPS,0000),'CPS NIGHTLY BKUP',
//             CLASS=B,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,TIME=60
//*==================================================================*
//* Multi-step backup: VSAM REPRO -> DB2 COPY -> INDEX -> VERIFY     *
//* On failure: hold downstream PYRECON# via event file delete        *
//*==================================================================*
//         JCLLIB ORDER=(CPS.PROD.PROCLIB)
//         SET  HLQ=CPS.PROD
//         SET  BKU=&HLQ..BKUP
//*
//STEP010  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//INACCT   DD DSN=&HLQ..VSAM.ACCT,DISP=SHR
//OUTACCT  DD DSN=&BKU..ACCT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(100,50),RLSE),
//            UNIT=TAPE,LABEL=(1,SL)
//SYSIN    DD *
  REPRO INFILE(INACCT) OUTFILE(OUTACCT)
/*
//*
//IFACCT   IF (STEP010.RC = 0) THEN
//STEP020  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//INCTRL   DD DSN=&HLQ..VSAM.CTRL,DISP=SHR
//OUTCTRL  DD DSN=&BKU..CTRL(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(10,5),RLSE),UNIT=TAPE
//SYSIN    DD *
  REPRO INFILE(INCTRL) OUTFILE(OUTCTRL)
/*
//ENDIFA   ENDIF
//*
//STEP030  EXEC PGM=DSNUTILB,PARM='DB2P,PYBKCOPY',COND=(4,LT)
//STEPLIB  DD DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSIN    DD *
  COPY TABLESPACE PYDB.PYTXNS
       COPYDDN(COPYTS1)
       SHRLEVEL CHANGE
       FULL YES
  COPY TABLESPACE PYDB.PYSTAT
       COPYDDN(COPYTS2)
       SHRLEVEL CHANGE
       FULL YES
/*
//COPYTS1  DD DSN=&BKU..DB2.PYTXNS(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(200,50),RLSE),UNIT=TAPE
//COPYTS2  DD DSN=&BKU..DB2.PYSTAT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,20),RLSE),UNIT=TAPE
//*
//STEP040  EXEC PGM=IEBGENER,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD *
CPS BACKUP INDEX
ACCT=&BKU..ACCT
CTRL=&BKU..CTRL
PYTXNS=&BKU..DB2.PYTXNS
PYSTAT=&BKU..DB2.PYSTAT
TS=&LYYMMDD
/*
//SYSUT2   DD DSN=&BKU..INDEX(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD DUMMY
//*
//IFFAIL   IF ((STEP010.RC GT 4) OR (STEP030.RC GT 4)) THEN
//STEP090  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE CPS.PROD.EVENT.BKUP.OK PURGE
  SET MAXCC=0
/*
//ALERT    EXEC PGM=IKJEFT01
//SYSTSIN  DD *
  TRANSMIT OPS-CPS MSG('PYBACKUP# FAILED - HOLD EOD')
/*
//SYSTSPRT DD SYSOUT=*
//ELSEOK   ELSE
//STEP091  EXEC PGM=IEFBR14
//OKFILE   DD DSN=CPS.PROD.EVENT.BKUP.OK,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,1),DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//ENDIFF   ENDIF
//
