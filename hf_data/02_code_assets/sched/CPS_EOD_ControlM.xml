<?xml version="1.0" encoding="UTF-8"?>
<!-- Control-M folder: CPS_EOD  |  Doc related: DEP-CPS-001 / PYRECON# -->
<DEFTABLE>
  <FOLDER FOLDER_NAME="CPS_EOD" PLATFORM="MVS" DATACENTER="HK_MAINFRAME">
    <JOB JOBNAME="PYFXRATE#" MEMNAME="PYFXRATE#" MEMLIB="CPS.PROD.JCL"
         APPLICATION="CPS" SUB_APPLICATION="EOD" CREATED_BY="cps.sched"
         CRITICAL="0" TASKTYPE="Job" CYCLIC="0">
      <TIME FROM="22:30" UNTIL="23:00"/>
      <RULE_BASED_CALENDARS NAME="HK_BANK_BD"/>
      <OUTCOND NAME="CPS-FXRATE-OK" ODATE="ODAT" SIGN="+"/>
      <ON CODE="NOTOK">
        <DOACTION ACTION="SP"/>
        <DOMAIL URGENCY="U" DEST="OPS-CPS@bank.internal"
                SUBJECT="PYFXRATE# failed" MESSAGE="Check FX feed"/>
      </ON>
    </JOB>

    <JOB JOBNAME="PYBACKUP#" MEMNAME="PYBACKUP#" MEMLIB="CPS.PROD.JCL"
         APPLICATION="CPS" SUB_APPLICATION="EOD" TASKTYPE="Job">
      <TIME FROM="02:00" UNTIL="03:30"/>
      <INCOND NAME="CPS-PREV-EOD-DONE" ODATE="PREV" AND_OR="A"/>
      <OUTCOND NAME="CPS-BKUP-OK" ODATE="ODAT" SIGN="+"/>
      <ON CODE="NOTOK">
        <DOACTION ACTION="SP"/>
        <DOCOND NAME="CPS-BKUP-OK" ODATE="ODAT" SIGN="-"/>
        <DOMAIL URGENCY="V" DEST="OPS-CPS@bank.internal"
                SUBJECT="PYBACKUP# FAILED - HOLD RECON"/>
      </ON>
    </JOB>

    <JOB JOBNAME="WAIT_GLS_EOD" TASKTYPE="Command" CREATED_BY="cps.sched"
         CMDLINE="/cps/bin/wait_event.sh GLS.EOD.DONE 3600">
      <TIME FROM="23:00" UNTIL="23:25"/>
      <OUTCOND NAME="GLS-EOD-DONE" ODATE="ODAT" SIGN="+"/>
    </JOB>

    <JOB JOBNAME="PYRECON#" MEMNAME="PYRECON#" MEMLIB="CPS.PROD.JCL"
         APPLICATION="CPS" SUB_APPLICATION="EOD" CRITICAL="1" TASKTYPE="Job">
      <TIME FROM="23:30" UNTIL="00:30"/>
      <INCOND NAME="CPS-FXRATE-OK" ODATE="ODAT" AND_OR="A"/>
      <INCOND NAME="CPS-BKUP-OK" ODATE="ODAT" AND_OR="A"/>
      <INCOND NAME="GLS-EOD-DONE" ODATE="ODAT" AND_OR="A"/>
      <OUTCOND NAME="CPS-RECON-DONE" ODATE="ODAT" SIGN="+"/>
      <OUTCOND NAME="CPS-PREV-EOD-DONE" ODATE="ODAT" SIGN="+"/>
      <QUANTITATIVE NAME="DB2P_UTIL" QUANT="1"/>
      <ON CODE="COMPSTAT EQ 4">
        <DOMAIL URGENCY="U" DEST="OPS-CPS@bank.internal"
                SUBJECT="PYRECON# RC=4 breaks present"
                MESSAGE="Review CPS.PROD.RECON.BREAK GDG"/>
        <DOACTION ACTION="OK"/>
      </ON>
      <ON CODE="COMPSTAT GE 8">
        <DOACTION ACTION="SP"/>
        <DOMAIL URGENCY="V" DEST="OPS-CPS@bank.internal"
                SUBJECT="PYRECON# HARD FAIL"/>
      </ON>
    </JOB>

    <JOB JOBNAME="PYRPTSTAT" TASKTYPE="Job" APPLICATION="CPS"
         SUB_APPLICATION="EOD" MEMNAME="PYRPTSTAT" MEMLIB="CPS.IBMI.JOBD">
      <TIME FROM="00:35" UNTIL="01:00"/>
      <INCOND NAME="CPS-RECON-DONE" ODATE="ODAT" AND_OR="A"/>
      <OUTCOND NAME="CPS-RPT-DONE" ODATE="ODAT" SIGN="+"/>
    </JOB>

    <JOB JOBNAME="PYDLQ_SWEEP" TASKTYPE="Command"
         CMDLINE="/cps/bin/tso_submit.sh PYOPS_DLQ_REPLAY 'CPSQM.PROD CPS.DLQ 200 N'">
      <TIME FROM="01:00" UNTIL="01:30"/>
      <INCOND NAME="CPS-RPT-DONE" ODATE="ODAT" AND_OR="A"/>
      <ON CODE="NOTOK">
        <DOMAIL URGENCY="U" DEST="OPS-CPS@bank.internal"
                SUBJECT="DLQ sweep failed"/>
      </ON>
    </JOB>
  </FOLDER>
</DEFTABLE>
