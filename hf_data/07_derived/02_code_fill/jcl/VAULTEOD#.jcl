//VAULTEOD JOB (VAULT,OPS),'VAULT EOD',CLASS=A,MSGCLASS=X,
//             REGION=0M,TIME=90
//* Order matches EODPROC0 source:
//*   CALL INTCALC0 -> TXNPOST0 -> GLPOST0 -> AUDTLOG0
//*   trial balance must be balanced or RC=8
//*----------------------------------------------------------------
//STEP010  EXEC PGM=EODPROC0
//STEPLIB  DD DSN=VAULT.TEST.LOAD,DISP=SHR
//         DD DSN=CARD.TEST.LOAD,DISP=SHR
//ACCTFILE DD DSN=VAULT.TEST.ACCT,DISP=SHR
//TXNFILE  DD DSN=VAULT.TEST.TXN,DISP=SHR
//GLFILE   DD DSN=VAULT.TEST.GL,DISP=SHR
//HOLDFILE DD DSN=VAULT.TEST.HOLD,DISP=SHR
//CTRFILE  DD DSN=VAULT.TEST.CTR,DISP=SHR
//AUDITLOG DD DSN=VAULT.TEST.AUDIT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,2),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//*
//IFBAL    IF (STEP010.RC LE 4) THEN
//STEP020  EXEC PGM=EOMPROC0,COND=(4,LT)
//* EOMPROC0 only on month-end; scheduler adds this step via
//* Control-M. Here it is conditional on EOD RC.
//STEPLIB  DD DSN=VAULT.TEST.LOAD,DISP=SHR
//ACCTFILE DD DSN=VAULT.TEST.ACCT,DISP=SHR
//FEEFILE  DD DSN=VAULT.TEST.FEE,DISP=SHR
//SYSOUT   DD SYSOUT=*
//ENDIFB   ENDIF
//*
//STEP030  EXEC PGM=SORT,COND=(8,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=VAULT.TEST.AUDIT(0),DISP=SHR
//SORTOUT  DD DSN=VAULT.TEST.AUDIT.SORTED(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,2),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,26,CH,A)
/*
//
