//CBSTM03A JOB (CARD,OPS),'STMT PRINT',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//* Driven by CBSTM03A.CBL
//*   SELECT STMT-FILE ASSIGN TO STMTFILE
//*   SELECT HTML-FILE ASSIGN TO HTMLFILE
//*   CALL 'CBSTM03B' USING WS-M03B-AREA  DD=TRNXFILE
//*   abend via CEE3ABD if totals break
//*----------------------------------------------------------------
//STEP010  EXEC PGM=CBSTM03A
//STEPLIB  DD DSN=CARD.TEST.LOAD,DISP=SHR
//TRNXFILE DD DSN=CARD.TEST.TRANSACT.KSDS,DISP=SHR
//STMTFILE DD DSN=CARD.TEST.STMT.TXT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(20,10),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//HTMLFILE DD DSN=CARD.TEST.STMT.HTML(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(20,10),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//*
//IFABEND  IF (STEP010.RC GT 4) THEN
//HOLD     EXEC PGM=IEFBR14
//* leave rerun to ops; CEE3ABD sets RC high
//SYSPRINT DD SYSOUT=*
//ENDIF    ENDIF
//
